<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- SharpFuzz rewrites IL at runtime through the CLR profiler; ReadyToRun
         (R2R) precompiled code bypasses IL instrumentation, so coverage feedback
         would be lost (issue 25 checkpoint B conclusion). Never publish the fuzz
         harness with PublishReadyToRun or PublishSingleFile. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\env-manager.csproj" />
  </ItemGroup>

</Project>
