<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>env-manager-cli</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Xxx91n/env-manager</PackageProjectUrl>
    <Copyright>Copyright (c) 2026 Env Manager Contributors</Copyright>
    <Version>0.13.0</Version>
    <Product>Env Manager</Product>
    <AssemblyTitle>Env Manager CLI</AssemblyTitle>
    <Description>Modern Windows environment variable manager with CLI + GUI</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="protection.defaults.json" LogicalName="EnvManager.protection.defaults.json"/>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Compliance.Redaction" Version="9.10.0"/>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EnvManager.Engine.Tests"/>
    <!-- The SharpFuzz harness exercises the internal LenientArgs parser, so it needs internals visible. -->
    <InternalsVisibleTo Include="EnvManager.Fuzz"/>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs"/>
    <!-- PROTOTYPE(p3-boundary-probes): the throwaway sops stub is a separate project. Its
         top-level-statement Program.cs must not join this CLI's compile, or its global code
         becomes the entry point and env-manager-cli.exe silently runs the stub instead. -->
    <Compile Remove="prototype\**\*.cs"/>
  </ItemGroup>

</Project>
