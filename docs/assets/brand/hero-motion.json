    { "id": "peak-staging", "enter": { "start": 1.5, "end": 1.95, "from": [0, 30] }, "exit": { "start": 4.6, "end": 5.0 } },
    { "id": "peak-prod", "enter": { "start": 2.0, "end": 2.45, "from": [0, 30] }, "exit": { "start": 4.6, "end": 5.0 } },
