[2.572, "o", "\u001b[1t\u001b[c\u001b[?1004h\u001b[?9001henv-manager-cli v0.9.30 | Commands: list,get,set,delete,toggle,backup,restore,diff,merge,validate,profile,path,agents,help | Scopes: user,system | Safe: no-credentials,injection-protected,write-serialized | Agents: env-manager-cli agents --json for full spec\r\n"]
