{
  "productName": "Env Manager",
  "version": "0.3.0",
  "identifier": "com.envmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Env Manager",
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "bin/env-manager-cli.exe",
      "bin/env-manager-cli.dll",
      "bin/env-manager-cli.runtimeconfig.json",
      "bin/env-manager-cli.deps.json"
    ]
  }
}
