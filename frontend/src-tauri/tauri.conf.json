{
  "productName": "Env Manager",
  "version": "0.9.30",
  "identifier": "com.envmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Env Manager",
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCQUQ1NTJCMThEREJBRjkKUldUNXV0MFlLMVd0VzVNZWxIU1VaWTM4NkZGUENhTmZmTVJPYU5lWFViVjZZbUZUbmN6RWc0V2cK",
      "endpoints": [
        "https://github.com/Xxx91n/env-manager/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "bin/env-manager-cli.exe",
      "bin/env-manager-cli.dll",
      "bin/env-manager-cli.runtimeconfig.json",
      "bin/env-manager-cli.deps.json",
      "bin/AGENTS.cli.md"
    ],
    "createUpdaterArtifacts": true
  }
}
