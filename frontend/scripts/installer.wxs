<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*" Name="Env Manager" Language="1033" Version="$(var.Version)"
           Manufacturer="Env Manager" UpgradeCode="349fb993-98bf-5bf6-984a-dae0cc68cbbb">
    <Package InstallerVersion="450" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of Env Manager is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- WixUI_InstallDir supplies the Welcome, License, InstallDir, VerifyReady and
         Finish dialogs (License has an empty body because no RTF is configured).
         The EnvManagerShortcutUI fragment adds the Optional Settings page that
         exposes INSTALLDESKTOPSHORTCUT (default 1) as a check box; the public
         property keeps working from the command line. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="EnvManagerShortcutUI" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <Icon Id="ProductIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <?if $(var.Win64) = "yes" ?>
        <Directory Id="ProgramFiles64Folder">
          <Directory Id="INSTALLDIR" Name="Env Manager">
            <Directory Id="LogsDir" Name="logs" />
          </Directory>
        </Directory>
      <?else ?>
        <Directory Id="ProgramFilesFolder">
          <Directory Id="INSTALLDIR" Name="Env Manager">
            <Directory Id="LogsDir" Name="logs" />
          </Directory>
        </Directory>
      <?endif ?>
      <!-- ProgramData directory for machine-level secret mount files -->
      <Directory Id="ProgramDataFolder">
        <Directory Id="EnvManagerDataDir" Name="EnvManager" />
      </Directory>
      <Directory Id="DesktopFolder" />
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Env Manager" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLDIR">
      <!-- Uninstall shortcut in INSTALLDIR, next to the exe.
           Per user request (cc-swich / ZCode parity). FireGiant How-To pattern:
           non-advertised shortcut to [System64Folder]msiexec.exe /x [ProductCode],
           paired with RegistryValue KeyPath for ICE compliance. -->
      <Component Id="UninstallShortcut" Guid="*" Win64="$(var.Win64)">
        <Shortcut Id="UninstallShortcutLnk" Name="Uninstall Env Manager"
                  Target="[System64Folder]msiexec.exe" Arguments="/x [ProductCode]"
                  Description="Uninstall Env Manager" Icon="ProductIcon" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\EnvManager" Name="UninstallShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
        <!-- RemoveFolder must live in a component rooted at INSTALLDIR, not in
             EnvManagerDataComponent (which is rooted at ProgramData). Placing it
             there silently produces no FolderRemove op for INSTALLDIR on
             uninstall (regression observed in v0.9.30 smoke test). -->
        <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
      </Component>
      <Component Id="GuiExecutable" Guid="5138848f-6498-4896-805f-26a0004665c7" Win64="$(var.Win64)">
        <File Id="GuiFile" Source="$(var.SourceDir)\env-manager.exe" KeyPath="yes" />
        <RemoveFile Id="RemoveResidue_GuiExecutable" Name="*.*" On="uninstall" />
      </Component>
      <Component Id="CliExecutable" Guid="a690f1b0-3987-450e-a4c0-4d8f7f478f1f" Win64="$(var.Win64)">
        <File Id="CliFile" Source="$(var.SourceDir)\env-manager-cli.exe" KeyPath="yes" />
        <RemoveFile Id="RemoveResidue_CliExecutable" Name="*.*" On="uninstall" />
      </Component>
      <Component Id="CliLibrary" Guid="*" Win64="$(var.Win64)">
        <File Id="CliLibraryFile" Source="$(var.SourceDir)\env-manager-cli.dll" KeyPath="yes" />
        <RemoveFile Id="RemoveResidue_CliLibrary" Name="*.*" On="uninstall" />
      </Component>
      <Component Id="CliDeps" Guid="*" Win64="$(var.Win64)">
        <File Id="CliDepsFile" Source="$(var.SourceDir)\env-manager-cli.deps.json" KeyPath="yes" />
        <RemoveFile Id="RemoveResidue_CliDeps" Name="*.*" On="uninstall" />
      </Component>
      <Component Id="CliRuntime" Guid="*" Win64="$(var.Win64)">
        <File Id="CliRuntimeFile" Source="$(var.SourceDir)\env-manager-cli.runtimeconfig.json" KeyPath="yes" />
        <RemoveFile Id="RemoveResidue_CliRuntime" Name="*.*" On="uninstall" />
      </Component>
      <Component Id="AgentGuide" Guid="*" Win64="$(var.Win64)">
        <File Id="AgentGuideFile" Source="$(var.SourceDir)\AGENTS.cli.md" KeyPath="yes" />
        <RemoveFile Id="RemoveResidue_AgentGuide" Name="*.*" On="uninstall" />
      </Component>
      <!-- env-manager-service.exe — Windows service binary for secret mount lifecycle -->
      <Component Id="ServiceExecutable" Guid="e61585c6-4c5b-437c-be39-082f8b64bade" Win64="$(var.Win64)">
        <File Id="ServiceFile" Source="$(var.SourceDir)\env-manager-service.exe" KeyPath="yes" />
        <RemoveFile Id="RemoveResidue_ServiceExecutable" Name="*.*" On="uninstall" />
        <ServiceInstall Id="EnvManagerService" Name="EnvManagerService" Type="ownProcess"
                        Start="auto" ErrorControl="normal" Description="Env Manager secret mount lifecycle service"
                        Arguments="--mode=service">
          <util:ServiceConfig
            FirstFailureActionType="restart"
            SecondFailureActionType="restart"
            ThirdFailureActionType="restart"
            RestartServiceDelayInSeconds="60"
            ResetPeriodInDays="1" />
        </ServiceInstall>
        <!-- Wait=no because the service binary never joins the SCM control protocol:
             it has no StartServiceCtrlDispatcher/ServiceMain/SetServiceStatus, so SCM
             never observes a Running state no matter how fast the process boots.
             A blocking wait would therefore always run to ServicesPipeTimeout and
             fail the install (1053) — the v0.9.26 hang. This is not a slow-start
             bound: adding time would not help, implementing the control protocol
             would (tracked in https://github.com/Xxx91n/env-manager/issues/141).
             ServiceInstall Start="auto" lets SCM try at next boot; GUI exposes a
             manual start. -->
        <ServiceControl Id="EnvManagerServiceControl" Name="EnvManagerService"
                        Stop="both" Remove="uninstall" Wait="no" />
      </Component>

      <!-- Stop the OLD EnvManagerService during MajorUpgrade (afterInstallExecute runs after RemoveExistingProducts) -->
      <Component Id="StopOldServiceOnUpgrade" Guid="*" Win64="$(var.Win64)">
        <Condition>WIX_UPGRADE_DETECTED</Condition>
        <CreateFolder />
        <RegistryValue Root="HKLM" Key="Software\EnvManager" Name="StopOldServiceOnUpgrade"
                       Type="integer" Value="1" KeyPath="yes" />
        <ServiceControl Id="StopOldServiceControl" Name="EnvManagerService"
                        Stop="uninstall" Wait="no" />
      </Component>

      <?if "$(var.WebViewLoaderPresent)" = "1" ?>
      <Component Id="WebViewLoader" Guid="*" Win64="$(var.Win64)">
        <File Id="WebViewLoaderFile" Source="$(var.SourceDir)\WebView2Loader.dll" KeyPath="yes" />
        <RemoveFile Id="RemoveResidue_WebViewLoader" Name="*.*" On="uninstall" />
      </Component>
      <?endif ?>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="*" Win64="$(var.Win64)">
        <Shortcut Id="ApplicationShortcut" Name="Env Manager" Target="[INSTALLDIR]env-manager.exe"
                  WorkingDirectory="INSTALLDIR" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\EnvManager" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*" Win64="$(var.Win64)">
        <Shortcut Id="DesktopShortcut" Name="Env Manager" Target="[INSTALLDIR]env-manager.exe"
                  WorkingDirectory="INSTALLDIR" Icon="ProductIcon" IconIndex="0" />
        <RegistryValue Root="HKCU" Key="Software\EnvManager" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
        <Condition>INSTALLDESKTOPSHORTCUT = "1"</Condition>
      </Component>
    </DirectoryRef>

    <!-- Backstop cleanup for legacy INSTALLDIR\logs residue.
         Prior versions wrote GUI logs under [INSTALLDIR]\logs. Wildcard RemoveFile only
         matches the specific logs subdirectory (not the whole INSTALLDIR — wixsharp
         #1114 anti-pattern avoided). RemoveFolder removes the empty dir afterwards. -->
    <DirectoryRef Id="LogsDir">
      <Component Id="LegacyLogsCleanup" Guid="*" Win64="$(var.Win64)">
        <CreateFolder />
        <!-- Uninstall-time cleanup only. The product owns this directory, so removing
             the logs it wrote while uninstalling is the uninstall's own byte; the
             upgrade-time pass lives in LegacyLogsCleanupOnUpgrade and a clean install
             or repair never touches this wildcard. -->
        <RemoveFile Id="RemoveLegacyLogsFiles" Name="*.log*" On="uninstall" />
        <RemoveFolder Id="RemoveLegacyLogsDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\EnvManager" Name="LegacyLogsCleanup"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- Install-time cleanup, upgrade only.
           Guid="*" resolves to the same component id across builds, so a major
           upgrade treats the new product as another client and skips the old
           product's component removal (observed in the MSI upgrade matrix:
           "Disallowing uninstallation ... since another client exists"). The old
           logs therefore have to be cleared by the NEW product while it upgrades.
           Conditioning on WIX_UPGRADE_DETECTED keeps that pass off the clean-install
           and repair paths, where the wildcard would delete unrelated files a user
           put in INSTALLDIR\logs. Key path is a registry value, the same shape as
           StopOldServiceOnUpgrade above. -->
      <Component Id="LegacyLogsCleanupOnUpgrade" Guid="*" Win64="$(var.Win64)">
        <Condition>WIX_UPGRADE_DETECTED</Condition>
        <CreateFolder />
        <RegistryValue Root="HKLM" Key="Software\EnvManager" Name="LegacyLogsCleanupOnUpgrade"
                       Type="integer" Value="1" KeyPath="yes" />
        <RemoveFile Id="RemoveLegacyLogsFilesOnUpgrade" Name="*.log*" On="install" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="EnvManagerDataDir">
      <Component Id="EnvManagerDataComponent" Guid="*" Win64="$(var.Win64)">
        <CreateFolder />
        <RegistryValue Root="HKLM" Key="Software\EnvManager" Name="DataDir"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="Env Manager" Level="1">
      <ComponentRef Id="GuiExecutable" />
      <ComponentRef Id="UninstallShortcut" />
      <ComponentRef Id="CliExecutable" />
      <ComponentRef Id="CliLibrary" />
      <ComponentRef Id="CliDeps" />
      <ComponentRef Id="CliRuntime" />
      <ComponentRef Id="AgentGuide" />
      <?if "$(var.WebViewLoaderPresent)" = "1" ?>
      <ComponentRef Id="WebViewLoader" />
      <?endif ?>
      <ComponentRef Id="ServiceExecutable" />
      <ComponentRef Id="EnvManagerDataComponent" />
      <ComponentRef Id="StopOldServiceOnUpgrade" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="LegacyLogsCleanup" />
      <ComponentRef Id="LegacyLogsCleanupOnUpgrade" />
    </Feature>

  </Product>

  <!-- WixUI extension dialogs cannot be redefined in the .wxs (light rejects the
       duplicate Dialog symbol), so the shortcut option gets its own page instead of
       a control on InstallDirDlg. Tying both layout and navigation to the shipped
       WixUI_InstallDir set keeps the rest of the wizard intact. -->
  <Fragment>
    <UI Id="EnvManagerShortcutUI">
      <Dialog Id="DesktopShortcutDlg" Width="370" Height="270" Title="!(loc.DesktopShortcutDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.DesktopShortcutDlgDescription)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.DesktopShortcutDlgTitle)" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="OptionsText" Type="Text" X="20" Y="55" Width="320" Height="30" NoPrefix="yes" Text="!(loc.DesktopShortcutDlgOptionsText)" />
        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="95" Width="320" Height="17"
                 Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1"
                 Text="!(loc.DesktopShortcutDlgCheckBox)" />
      </Dialog>

      <!-- InstallDirDlg's built-in Next publishes verify the path and open
           VerifyReadyDlg at Order 4 in WiX 3.14. Publish ordering is ascending and
           the last NewDialog wins, so this page has to run after that transition. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="DesktopShortcutDlg" Order="6">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>
      <!-- MSI draws a check box as checked whenever its property is non-empty, so a
           command-line INSTALLDESKTOPSHORTCUT=0 would otherwise show a checked box
           while the component condition suppresses the shortcut. Clear the property
           before the dialog is created; [WIXUI_EMPTY] is intentionally undefined. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Property="INSTALLDESKTOPSHORTCUT" Value="[WIXUI_EMPTY]" Order="5">INSTALLDESKTOPSHORTCUT = "0"</Publish>
      <Publish Dialog="DesktopShortcutDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1">1</Publish>
      <Publish Dialog="DesktopShortcutDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="1">1</Publish>
      <!-- VerifyReadyDlg's stock Back goes straight to InstallDirDlg on first
           install; route it through this page so Back and Next walk the same
           sequence. Published after the stock transition at Order 1. -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="DesktopShortcutDlg" Order="3">NOT Installed</Publish>
    </UI>
  </Fragment>

</Wix>
