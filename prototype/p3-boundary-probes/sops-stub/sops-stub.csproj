<Project Sdk="Microsoft.NET.Sdk">

  <!-- PROTOTYPE (p3-boundary-probes): throwaway sops stand-in for the V2/V3 legs.
       Never merged to main; self-contained so a LocalSystem service child does not
       depend on a machine-wide .NET runtime being present. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>sops-stub</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

</Project>
